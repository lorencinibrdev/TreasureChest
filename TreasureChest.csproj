<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);CA1416</NoWarn>
    </PropertyGroup>

    <Target Name="CompileGResources" BeforeTargets="BeforeBuild">
        <Exec Command="glib-compile-resources &quot;$(MSBuildProjectDirectory)/data/TreasureChest.gresource.xml&quot; --target=&quot;$(MSBuildProjectDirectory)/data/TreasureChest.gresource&quot;" />
    </Target>

    <!-- 1. Automatically compile the schema before building if the XML changed -->
    <Target Name="CompileGSettingsSchemas" BeforeTargets="BeforeBuild"
            Inputs="data/io.github.lorencinibrdev.TreasureChest.gschema.xml"
            Outputs="data/gschemas.compiled">
        <Message Text="[MSBUILD] Compiling GSettings schema..." />
        <Exec Command="glib-compile-schemas data/" />
    </Target>

    <!-- 2. Copy the compiled schema binary to bin/ output directory -->
    <ItemGroup>
        <None Include="data/gschemas.compiled" CopyToOutputDirectory="PreserveNewest" />
        <None Include="data/TreasureChest.gresource" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="GirCore.Adw-1" Version="0.8.1" />
      <PackageReference Include="GirCore.Gtk-4.0" Version="0.8.1" />
      <PackageReference Include="GirCore.Secret-1" Version="0.8.1" />
      <PackageReference Include="GirCore.WebKit-6.0" Version="0.8.1" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="icons\" />
    </ItemGroup>

</Project>
