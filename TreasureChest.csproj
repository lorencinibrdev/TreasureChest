<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);CA1416</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="GirCore.Adw-1" Version="0.8.1" />
      <PackageReference Include="GirCore.Gtk-4.0" Version="0.8.1" />
      <PackageReference Include="GirCore.Secret-1" Version="0.8.1" />
      <PackageReference Include="GirCore.WebKit-6.0" Version="0.8.1" />
    </ItemGroup>

</Project>
